#!/usr/bin/env bash
set -euo pipefail

resume_flag=""

while getopts "rc" opt; do
  case "$opt" in
    r) resume_flag="-r" ;;
    c) resume_flag="-c" ;;
    *) echo "usage: cct [-r|-c] [worktree-name]" >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -gt 1 ]; then
  echo "usage: cct [-r|-c] [worktree-name]" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "cct: not inside a git repository" >&2
  exit 1
}

session="$(basename "$repo_root")"

claude_cmd="claude"
[ -n "$resume_flag" ] && claude_cmd="$claude_cmd $resume_flag"

if [ $# -eq 0 ]; then
  window="main"
  target_dir="$repo_root"
else
  window="$1"
  target_dir="$repo_root/.claude/worktrees/$window"
  claude_cmd="$claude_cmd -w $window"
fi

attach_target() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session:$window"
  else
    tmux attach-session -t "$session:$window"
  fi
}

if tmux has-session -t="$session" 2>/dev/null && \
   tmux list-windows -t "$session" -F '#W' | grep -qx "$window"; then
  attach_target
  exit 0
fi

if tmux has-session -t="$session" 2>/dev/null; then
  tmux new-window -d -t "$session:" -n "$window" -c "$repo_root"
else
  tmux new-session -d -s "$session" -n "$window" -c "$repo_root"
fi

tmux split-window -h -l 33% -t "$session:$window" -c "$repo_root"
tmux send-keys -t "$session:$window.1" "$claude_cmd" C-m

if [ -d "$target_dir" ]; then
  tmux send-keys -t "$session:$window.0" "cd '$target_dir' && vi ." C-m
else
  tmux send-keys -t "$session:$window.0" "until [ -d '$target_dir' ]; do sleep 0.5; done; cd '$target_dir' && vi ." C-m
fi

tmux select-pane -t "$session:$window.0"
attach_target
