#!/usr/bin/env bash
set -euo pipefail

dry_run="no"
skip_ai="no"
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

usage() {
  cat >&2 <<'EOF'
usage: scripts/install-deps [--dry-run] [--skip-ai]

Install the external tools used by this dotfiles repository.

  --dry-run   Print commands without running them.
  --skip-ai   Skip Claude Code, Codex, and Herdr integrations.
EOF
  exit "${1:-1}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)
      dry_run="yes"
      shift
      ;;
    --skip-ai)
      skip_ai="yes"
      shift
      ;;
    -h|--help)
      usage 0
      ;;
    *)
      usage 1
      ;;
  esac
done

run() {
  local cmd=("$@")

  printf "+"
  for arg in "${cmd[@]}"; do
    printf " %q" "$arg"
  done
  printf "\n"

  if [ "$dry_run" = "no" ]; then
    "${cmd[@]}"
  fi
}

ensure_homebrew() {
  if command -v brew >/dev/null 2>&1; then
    return
  fi

  run /bin/bash -c '$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)'

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

brew_install_formulae() {
  local formulae=(
    neovim
    tmux
    lazydocker
    gh
    jq
    ripgrep
    mise
    mysql-client
    postgresql
    herdr
  )

  run brew update
  run brew install "${formulae[@]}"
}

brew_install_casks() {
  local casks=(
    ghostty
    font-jetbrains-mono-nerd-font
  )

  if [ "$skip_ai" = "no" ]; then
    casks+=(codex)
  fi

  run brew install --cask "${casks[@]}"
}

install_mise_tools() {
  run env MISE_GLOBAL_CONFIG_FILE="$repo_root/mise/config.toml" mise install
}

install_claude_code() {
  [ "$skip_ai" = "no" ] || return 0
  run env MISE_GLOBAL_CONFIG_FILE="$repo_root/mise/config.toml" \
    mise exec -- npm install -g @anthropic-ai/claude-code
}

install_herdr_integrations() {
  [ "$skip_ai" = "no" ] || return 0
  run herdr integration install claude
  run herdr integration install codex
}

main() {
  ensure_homebrew
  brew_install_formulae
  brew_install_casks
  install_mise_tools
  install_claude_code
  install_herdr_integrations

  cat <<'EOF'

Done.

Manual follow-up:
  - Run: gh auth login
  - Run: codex login
  - Run Claude Code's login flow on first launch.
  - The Makefile's setup target handles config links and Neovim bootstrap.
  - Restart the shell after setup completes.
EOF
}

main
