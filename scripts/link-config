#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
timestamp=$(date +%Y%m%d%H%M%S)

link_config() {
  local source=$1
  local target=$2
  local backup
  local suffix=0

  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    printf "skip: %s already points to %s\n" "$target" "$source"
    return
  fi

  if [ -e "$target" ] || [ -L "$target" ]; then
    backup="${target}.backup-${timestamp}"
    while [ -e "$backup" ] || [ -L "$backup" ]; do
      suffix=$((suffix + 1))
      backup="${target}.backup-${timestamp}-${suffix}"
    done

    mv "$target" "$backup"
    printf "backup: %s -> %s\n" "$target" "$backup"
  fi

  ln -s "$source" "$target"
  printf "link: %s -> %s\n" "$target" "$source"
}

link_config "$repo_root/nvim" "$HOME/.config/nvim"
link_config "$repo_root/ghostty/config" "$HOME/.config/ghostty/config"
link_config "$repo_root/tmux/tmux.conf" "$HOME/.config/tmux/tmux.conf"
link_config "$repo_root/herdr/config.toml" "$HOME/.config/herdr/config.toml"
link_config "$repo_root/mise" "$HOME/.config/mise"
link_config "$repo_root/zsh/zshrc" "$HOME/.zshrc"
